{
  "name": "maicora",
  "private": true,
  "version": "0.1.0",
  "description": "Maicora - agent-first business system (trimmed MVP)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --filter=./apps/** run build",
    "dev:api": "pnpm --filter @maicora/api dev",
    "dev:web": "pnpm --filter @maicora/web dev",
    "dev:mcp": "pnpm --filter @maicora/mcp dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "db:generate": "pnpm --filter @maicora/database generate",
    "db:migrate": "pnpm --filter @maicora/database migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
