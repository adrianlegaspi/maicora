# Maicora - example environment configuration.
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database (PostgreSQL, provisioned through Supabase in production) ---
# Local dev uses host port 5433 (see docker-compose.yml) to avoid colliding
# with a native Postgres install that may already be using 5432.
DATABASE_URL=postgres://maicora:maicora@localhost:5433/maicora
POSTGRES_PORT=5433

# --- Supabase (Auth) ---
# In production this points at a Supabase project. Locally it can point at a
# self-hosted Supabase Auth (GoTrue) instance. The frontend never receives
# these values; only the backend (apps/api) talks to Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me

# Local sign-in without a Supabase project: POST /api/auth/login accepts any
# email and mints a token signed with SUPABASE_JWT_SECRET above. Development
# only - the API refuses it when NODE_ENV=production.
AUTH_DEV_LOGIN=false

# --- AI provider (OpenAI-compatible API) ---
AI_API=https://provider.example/v1
AI_API_KEY=replace-me
AI_MODEL=gpt-4o-mini

# --- Fiscal engine (Python service) ---
FISCAL_ENGINE_URL=http://localhost:8090
FISCAL_ENGINE_SHARED_SECRET=replace-me
# sandbox | production
FISCAL_ENVIRONMENT=sandbox

# --- PAC (Proveedor Autorizado de Certificacion) ---
# The MVP ships a mock PAC for sandbox use. A real PAC integration is
# selected here for production and implemented behind the same interface.
PAC_PROVIDER=mock

# --- Service ports ---
API_PORT=4000
MCP_PORT=4100
WEB_PORT=5173
FISCAL_ENGINE_PORT=8090

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=info
